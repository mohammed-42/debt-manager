generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [citext]
}

model User {
  id                     String         @id @default(uuid()) @db.Uuid
  email                  String         @unique @db.Citext
  passwordHash           String         @map("password_hash")
  isVerified             Boolean        @default(false) @map("is_verified")
  verificationCodeHash   String?        @map("verification_code_hash")
  verificationCodeExpiry DateTime?      @map("verification_code_expiry")
  verificationAttempts   Int            @default(0) @map("verification_attempts")
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")
  debts                  Debt[]
  refreshTokens          RefreshToken[]

  @@map("users")
}

model Debt {
  id                 String      @id @default(uuid()) @db.Uuid
  userId             String      @map("user_id") @db.Uuid
  debtType           DebtType    @map("debt_type")
  name               String
  principal          Decimal?    @db.Decimal(12, 2)
  monthlyRepayment   Decimal?    @map("monthly_repayment") @db.Decimal(12, 2)
  tenureMonths       Int?        @map("tenure_months")
  interestRate       Decimal?    @map("interest_rate") @db.Decimal(5, 2)
  dueDay             Int         @map("due_day")
  status             String      @default("active")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")
  penaltyType        PenaltyType @default(flat) @map("penalty_type")
  penaltyValue       Decimal     @default(0) @map("penalty_value") @db.Decimal(10, 2)
  penaltyOutstanding Decimal     @default(0) @map("penalty_outstanding") @db.Decimal(12, 2)
  currentOutstanding Decimal?    @map("current_outstanding") @db.Decimal(12, 2)
  minimumPayment     Decimal?    @map("minimum_payment") @db.Decimal(12, 2)
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments           Payment[]
creditCardTransactions CreditCardTransaction[]
  @@index([userId])
  @@index([dueDay, status])
  @@map("debts")
}

model Payment {
  id               String            @id @default(uuid()) @db.Uuid
  debtId           String            @map("debt_id") @db.Uuid
  amount           Decimal           @db.Decimal(12, 2)
  paidAt           DateTime          @default(now()) @map("paid_at")
  status           PaymentStatus
  penaltyApplied   Decimal           @default(0) @map("penalty_applied")
  isPrepayment     Boolean           @default(false) @map("is_prepayment")
  prepaymentChoice PrepaymentChoice? @map("prepayment_choice")
  createdAt        DateTime          @default(now()) @map("created_at")
  debt             Debt              @relation(fields: [debtId], references: [id], onDelete: Cascade)

  @@index([debtId])
  @@map("payments")
}
model CreditCardTransaction {
  id              String   @id @default(uuid()) @db.Uuid
  debtId          String   @map("debt_id") @db.Uuid
  amount          Decimal  @db.Decimal(12, 2)
  description     String?
  transactionDate DateTime @default(now()) @map("transaction_date")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  debt Debt @relation(fields: [debtId], references: [id], onDelete: Cascade)

  @@index([debtId])
  @@index([transactionDate])
  @@map("credit_card_transactions")
}

model RefreshToken {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  tokenHash       String   @map("token_hash")
  deviceInfo      String?  @map("device_info")
  ipAddress       String?  @map("ip_address")
  expiresAt       DateTime @map("expires_at")
  revoked         Boolean  @default(false)
  createdAt       DateTime @default(now()) @map("created_at")
  tokenLookupHash String?  @unique @map("token_lookup_hash")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

enum DebtType {
  loan
  credit_card
  third_party
}

enum PaymentStatus {
  on_time
  late
  partial
}

enum PrepaymentChoice {
  reduce_tenure
  reduce_emi
}

enum PenaltyType {
  flat
  percentage
}
